{
  "name": "Company",
  "type": "object",
  "description": "A company node in the relationship graph",
  "properties": {
    "name": { "type": "string", "description": "Display name" },
    "key": { "type": "string", "description": "Normalized name used to dedupe (lowercase, no suffixes)" },
    "kind": { "type": "string", "enum": ["public", "private", "investor"], "default": "private" },
    "sector": { "type": "string" },
    "value_usd": { "type": "number", "description": "Market value or last valuation in USD (approximate)" },
    "value_as_of": { "type": "string", "description": "Date of the market value figure, if known" },
    "value_source_url": { "type": "string", "description": "Page the market value came from" },
    "value_source": { "type": "string", "description": "Label for a value that came from a data feed, e.g. a stock quote" },
    "value_fetched": { "type": "string", "description": "ISO time the market value was last sourced" },
    "ticker": { "type": "string", "description": "Stock ticker, for public companies" },
    "description": { "type": "string" },
    "last_fetched": { "type": "string", "description": "ISO time of the last live lookup; empty for seed-only companies" },
    "searched": { "type": "boolean", "description": "Someone looked it up in the app (not just the cache pre-fill)" },
    "prefilled": { "type": "boolean", "description": "Mapped by the deep cache pre-fill: kept for good, never re-searched unless forced" },
    "origin": { "type": "string", "enum": ["seed", "live"], "default": "live" }
  },
  "required": ["name", "key"]
}
