{
  "name": "Relationship",
  "type": "object",
  "description": "A directed relationship. Direction follows the money: investor -> investee, buyer -> seller, acquirer -> acquired, owner -> subsidiary.",
  "properties": {
    "key": { "type": "string", "description": "source_key|type|target_key, used to dedupe" },
    "source": { "type": "string", "description": "Company key of the payer / investor / acquirer" },
    "target": { "type": "string", "description": "Company key of the receiver / investee / acquired" },
    "type": {
      "type": "string",
      "enum": ["owner", "investment", "venture", "hardware", "cloud", "software", "supplier", "acquisition", "partnership", "competitor"]
    },
    "amount_usd": { "type": "number", "description": "Deal size in USD when reported" },
    "label": { "type": "string", "description": "One-line callout shown on the graph" },
    "date": { "type": "string" },
    "source_url": { "type": "string", "description": "Article the relationship was taken from" },
    "evidence": { "type": "string", "description": "Short quote from the source supporting the relationship" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "origin": { "type": "string", "enum": ["seed", "live", "llm_web"], "default": "live" }
  },
  "required": ["key", "source", "target", "type"]
}
